# Maintainer: Rafli Adi Pratama <rafliadipratama@gmail.com>

pkgname=sorafy-bin
_pkgname=sorafy
pkgver=2.0.0
pkgrel=1
pkgdesc="SoraFy - High-fidelity cross-platform music streaming player with MPD, AI MCP & Jam Remote"
arch=('x86_64')
url="https://github.com/rafliadipratama/sorafy"
license=('GPL-3.0-only')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'glib2'
    'gtk3'
    'libcups'
    'libdrm'
    'libnotify'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
)
optdepends=(
    'yt-dlp: For YouTube stream resolution and offline audio caching'
    'mpc: For terminal-based MPD playback control'
    'ncmpcpp: For ncurses-based visualizer and music browser'
)
provides=('sorafy')
conflicts=('sorafy')
options=('!strip')

source_x86_64=("https://github.com/rafliadipratama/sorafy/releases/download/v${pkgver}/sorafy_${pkgver}_amd64.deb")
sha256sums_x86_64=('SKIP')

package() {
    # Extract data archive from the Debian package
    bsdtar -xf "data.tar."* -C "${pkgdir}/"

    # Ensure correct permissions
    chmod -R u=rwX,go=rX "${pkgdir}/usr"
    chmod 755 "${pkgdir}/usr/bin/sorafy"
}
