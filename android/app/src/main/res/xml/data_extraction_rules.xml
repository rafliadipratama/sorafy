<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Auth state is excluded so no sign-in credential
  can leave the device via cloud backup or adb transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="musiceuy_yt_auth.xml" />
        <exclude domain="sharedpref" path="musiceuy_discord_rpc.xml" />
        <exclude domain="sharedpref" path="musiceuy_lastfm.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="musiceuy_yt_auth.xml" />
        <exclude domain="sharedpref" path="musiceuy_discord_rpc.xml" />
        <exclude domain="sharedpref" path="musiceuy_lastfm.xml" />
    </device-transfer>
</data-extraction-rules>
