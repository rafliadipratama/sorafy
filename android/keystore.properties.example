# Release signing credentials for the Android app.
#
# Copy to `android/keystore.properties` and fill in. The real file is
# git-ignored and must never be committed.
#
# Generate a keystore once (keep the backup somewhere safe — losing it means
# you can no longer ship updates to existing installs):
#
#   keytool -genkey -v -keystore release.jks -alias sorafy \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# In CI, set these as secrets instead of using this file:
#   SORAFY_KEYSTORE_FILE, SORAFY_KEYSTORE_PASSWORD,
#   SORAFY_KEY_ALIAS, SORAFY_KEY_PASSWORD
#
# Without these, `assembleRelease` still builds but leaves the APK UNSIGNED
# (app-release-unsigned.apk), which cannot be installed. That is deliberate:
# falling back to the debug key would let anyone sign a fake update.

storeFile=release.jks
storePassword=
keyAlias=sorafy
keyPassword=
