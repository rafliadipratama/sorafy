{
  "name": "sorafy",
  "desktopName": "sorafy",
  "version": "2.0.0",
  "description": "SoraFy - High-fidelity cross-platform music streaming (macOS, Linux & Windows)",
  "homepage": "https://github.com/rafliadipratama/sorafy",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "build:linux:all": "electron-builder --linux AppImage deb rpm snap",
    "build:snap": "electron-builder --linux snap",
    "build:win": "electron-builder --win nsis",
    "dist": "electron-builder",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.rafliadipratama.sorafy",
    "productName": "SoraFy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "src/**/*",
      "remote-web/**/*",
      "!src-tauri/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src-tauri/icons/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extraResources": [
        {
          "from": "bin/darwin/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "dmg": {
      "title": "SoraFy",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "icon": "src-tauri/icons/icon.png",
      "executableName": "sorafy",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap"
      ],
      "category": "Audio",
      "extraResources": [
        {
          "from": "bin/linux/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "summary": "High-fidelity music streaming player with MPD, AI MCP & Jam Remote",
      "plugs": [
        "default",
        "audio-playback",
        "network",
        "network-bind",
        "home",
        "removable-media"
      ]
    },
    "deb": {
      "maintainer": "Rafli Adi Pratama <rafliadipratama@gmail.com>",
      "packageCategory": "sound"
    },
    "rpm": {
      "category": "Applications/Multimedia"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoraFy"
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "bin/win32/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ]
    }
  },
  "keywords": [
    "sorafy",
    "music",
    "desktop",
    "macos",
    "dmg",
    "tauri",
    "rust",
    "electron"
  ],
  "author": {
    "name": "Rafli Adi Pratama",
    "email": "rafliadipratama@gmail.com"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "des.js": "^1.1.0",
    "iconsax": "^0.1.1",
    "qrcode": "^1.5.4"
  }
}
