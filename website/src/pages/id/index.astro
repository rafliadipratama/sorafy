---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import Superpowers from '../../components/Superpowers.astro';
import Downloads from '../../components/Downloads';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'id';
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title="SoraFy — Pemutar & Pengalir Musik High-Fidelity Gratis Tanpa Iklan"
  description="SoraFy adalah aplikasi streaming musik sumber terbuka berkualitas tinggi tanpa iklan atau pelacakan. Impor playlist, bernyanyi dengan lirik sinkron, dan atur pemutaran dari HP dan terminal."
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Features lang={lang} />
    <Superpowers lang={lang} />
    <Downloads
      client:visible
      lang={lang}
      eyebrow={t('dl_eyebrow')}
      title={t('dl_title')}
      desc={t('dl_desc')}
      recommendedText={t('dl_recommended')}
      universalText={t('dl_universal')}
    />
    <Comparison lang={lang} />
    <FAQ lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
