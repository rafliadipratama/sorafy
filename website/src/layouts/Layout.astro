---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'id';
}

const {
  title = "SoraFy — Free Open-Source Music Player & Spotify Alternative (Zero Ads)",
  description = "SoraFy is a free, open-source high-fidelity music streaming app without ads or tracking. Search any song, sync real-time lyrics, import playlists, and control playback from your phone and terminal.",
  lang = "en"
} = Astro.props;

const siteUrl = "https://rafliadipratama.github.io";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = lang === 'id' ? `${siteUrl}${base}/id` : `${siteUrl}${base}`;
const ogImageUrl = `${siteUrl}${base}/assets/logo_monogram.png`;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SoraFy",
  "operatingSystem": "Windows 10/11, macOS, Linux, Android",
  "applicationCategory": "MultimediaApplication",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  },
  "description": description,
  "url": canonicalUrl,
  "downloadUrl": "https://github.com/rafliadipratama/sorafy/releases/latest"
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={`${siteUrl}${base}`} />
  <link rel="alternate" hreflang="id" href={`${siteUrl}${base}/id`} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}${base}`} />

  <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/favicon.png`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Schema.org SoftwareApplication JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="bg-canvas text-primary selection:bg-[#00E599] selection:text-black">
  <slot />
  <script is:inline>
    // Ensure the landing page always opens at the very top hero banner when visiting without hash
    if (!window.location.hash && 'scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    }
  </script>
</body>
</html>
