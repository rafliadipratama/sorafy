---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="bg-surface border-b border-subtle text-xs py-2 px-4" role="region" aria-label="Announcement">
  <div class="max-w-7xl mx-auto flex items-center justify-center gap-3 flex-wrap">
    <span class="bg-emerald-subtle text-[#00E599] border border-emerald-subtle px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider">
      {t('announcement_pill')}
    </span>
    <span class="text-neutral-300">
      {t('announcement_text')}
    </span>
    <a href="#downloads" class="text-[#00E599] font-semibold inline-flex items-center gap-1 hover:underline">
      {t('announcement_link')}
    </a>
  </div>
</aside>
