---
import { useTranslations } from '../i18n/ui';
import TerminalShowcase from './TerminalShowcase';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 border-t border-subtle bg-container-alt" id="superpowers">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-[#00E599] inline-block mb-3">
        {t('super_eyebrow')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t('super_title')}
      </h2>
      <p class="text-neutral-400 text-base leading-relaxed">
        {t('super_desc')}
      </p>
    </div>

    <!-- 6 Superpowers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
      <!-- 1. Jam Remote -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 4120</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_jam_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_jam_desc')}</p>
      </div>

      <!-- 2. MPD Daemon -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 6600</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_mpd_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_mpd_desc')}</p>
      </div>

      <!-- 3. AI MCP -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"></path>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 8800</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_mcp_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_mcp_desc')}</p>
      </div>

      <!-- 4. Listening Recap -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 20v-6M6 20V10M18 20V4"></path>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">100% Offline</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_recap_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_recap_desc')}</p>
      </div>

      <!-- 5. Discord RPC -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Discord RPC</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_discord_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_discord_desc')}</p>
      </div>

      <!-- 6. Themes -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 000 20 10 10 0 000-20"></path>
            </svg>
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">5 Presets</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_theme_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_theme_desc')}</p>
      </div>
    </div>

    <!-- Terminal Code Showcase Component -->
    <TerminalShowcase client:visible lang={lang} />
  </div>
</section>
