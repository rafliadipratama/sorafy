---
import { useTranslations } from '../i18n/ui';
import TerminalShowcase from './TerminalShowcase';
import { Mobile, CommandSquare, CpuSetting, Chart21, Colorfilter } from 'iconsax-react';
import { OfficialDiscordIcon } from './OfficialIcons';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 border-t border-subtle bg-container-alt" id="superpowers">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-[#00E599] inline-block mb-3">
        {t('super_eyebrow')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t('super_title')}
      </h2>
      <p class="text-neutral-400 text-base leading-relaxed">
        {t('super_desc')}
      </p>
    </div>

    <!-- 6 Superpowers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
      <!-- 1. Jam Remote -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <Mobile size={20} variant="Linear" className="text-[#00E599]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 4120</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_jam_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_jam_desc')}</p>
      </div>

      <!-- 2. MPD Daemon -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <CommandSquare size={20} variant="Linear" className="text-[#00E599]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 6600</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_mpd_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_mpd_desc')}</p>
      </div>

      <!-- 3. AI MCP -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <CpuSetting size={20} variant="Linear" className="text-[#00E599]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Port 8800</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_mcp_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_mcp_desc')}</p>
      </div>

      <!-- 4. Listening Recap -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <Chart21 size={20} variant="Linear" className="text-[#00E599]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">100% Offline</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_recap_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_recap_desc')}</p>
      </div>

      <!-- 5. Discord RPC -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#5865F2]">
            <OfficialDiscordIcon className="w-5 h-5 text-[#5865F2]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">Discord RPC</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_discord_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_discord_desc')}</p>
      </div>

      <!-- 6. Themes -->
      <div class="bg-surface border border-subtle hover:border-medium rounded-2xl p-6 flex flex-col gap-3 transition-colors">
        <div class="flex items-center justify-between">
          <div class="w-9 h-9 rounded bg-surface-elevated border border-subtle flex items-center justify-center text-[#00E599]">
            <Colorfilter size={20} variant="Linear" className="text-[#00E599]" />
          </div>
          <span class="text-[11px] font-mono-code font-bold px-2 py-0.5 rounded bg-surface-elevated border border-subtle text-neutral-400">5 Presets</span>
        </div>
        <h3 class="text-base font-bold text-white">{t('super_theme_title')}</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">{t('super_theme_desc')}</p>
      </div>
    </div>

    <!-- Terminal Code Showcase Component -->
    <TerminalShowcase client:visible lang={lang} />
  </div>
</section>
    </div>

    <!-- Terminal Code Showcase Component -->
    <TerminalShowcase client:visible lang={lang} />
  </div>
</section>
