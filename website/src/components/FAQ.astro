---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 border-t border-subtle" id="faq">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-[#00E599] inline-block mb-3">
        {t('faq_eyebrow')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        {t('faq_title')}
      </h2>
      <p class="text-neutral-400 text-base leading-relaxed">
        {t('faq_desc')}
      </p>
    </div>

    <div class="flex flex-col gap-3.5">
      <!-- Q1 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors" open>
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q1')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a1')}
        </div>
      </details>

      <!-- Q2 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors">
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q2')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a2')}
        </div>
      </details>

      <!-- Q3 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors">
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q3')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a3')}
        </div>
      </details>

      <!-- Q4 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors">
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q4')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a4')}
        </div>
      </details>

      <!-- Q5 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors">
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q5')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a5')}
        </div>
      </details>

      <!-- Q6 -->
      <details class="group bg-surface border border-subtle hover:border-medium rounded-xl overflow-hidden transition-colors">
        <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-semibold text-white cursor-pointer select-none">
          <span>{t('faq_q6')}</span>
          <span class="text-[#00E599] text-xl transition-transform group-open:rotate-45 shrink-0 ml-4">+</span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-neutral-400 leading-relaxed border-t border-subtle/50 pt-3">
          {t('faq_a6')}
        </div>
      </details>
    </div>
  </div>
</section>
