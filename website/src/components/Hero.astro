---
import { useTranslations } from '../i18n/ui';
import MockupPlayer from './MockupPlayer.astro';
import HeroDownloadButton from './HeroDownloadButton';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pt-16 pb-20 px-6 relative" id="hero">
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-12 text-center">
    <!-- Header Copy -->
    <div class="max-w-3xl flex flex-col items-center">
      <!-- Badge Tag -->
      <div class="inline-flex items-center gap-2 bg-surface border border-subtle px-3.5 py-1.5 rounded-full text-xs font-semibold text-neutral-300 mb-6">
        <span class="w-2 h-2 rounded-full bg-[#00E599]"></span>
        <span>{t('hero_badge')}</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
        {t('hero_title')}
      </h1>

      <!-- Subhead -->
      <p class="text-base sm:text-lg text-neutral-400 leading-relaxed mb-8 max-w-2xl">
        {t('hero_desc')}
      </p>

      <!-- CTA Action Group -->
      <div class="flex items-center justify-center gap-4 flex-wrap mb-7">
        <HeroDownloadButton client:load defaultText={t('btn_hero_download')} lang={lang} />
        
        <a 
          href="https://github.com/rafliadipratama/sorafy" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 bg-surface hover:bg-surface-elevated border border-medium hover:border-strong text-white font-semibold text-base px-6 py-3.5 rounded-lg transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>{t('btn_hero_github')}</span>
        </a>
      </div>

      <!-- Platforms Bar -->
      <div class="flex items-center justify-center gap-2.5 flex-wrap text-xs text-neutral-400">
        <span>{t('hero_available_on')}</span>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 bg-surface border border-subtle px-2.5 py-1 rounded text-neutral-300 font-medium">Windows</span>
          <span class="inline-flex items-center gap-1.5 bg-surface border border-subtle px-2.5 py-1 rounded text-neutral-300 font-medium">Linux (AppImage / deb / rpm)</span>
          <span class="inline-flex items-center gap-1.5 bg-surface border border-subtle px-2.5 py-1 rounded text-neutral-300 font-medium">macOS</span>
          <span class="inline-flex items-center gap-1.5 bg-surface border border-subtle px-2.5 py-1 rounded text-neutral-300 font-medium">Android</span>
        </div>
      </div>
    </div>

    <!-- Application UI Mockup Showcase -->
    <MockupPlayer lang={lang} />
  </div>
</section>
