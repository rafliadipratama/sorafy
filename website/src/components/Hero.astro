---
import { useTranslations } from '../i18n/ui';
import Typewriter from './Typewriter';
import HeroMockupStage from './HeroMockupStage.astro';
import HeroDownloadsBox from './HeroDownloadsBox';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative z-20 mx-auto w-full max-w-7xl px-4 pt-4 sm:pt-6 pb-12 sm:pb-16 md:px-8 overflow-hidden" id="hero">
  <!-- Blueprint Grid Pattern in Background (inspired by nuclearplayer.com) -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_70%,transparent_100%)]"></div>

  <!-- Header Section with Dynamic Typewriter -->
  <div class="mb-6 sm:mb-8 text-center relative z-10">
    <span class="text-neutral-500 mb-2 inline-block text-[11px] font-bold tracking-[0.3em] uppercase">
      EST. 2024
    </span>
    <h1 class="text-2xl leading-tight font-black uppercase sm:text-4xl md:text-5xl lg:text-[3.25rem] text-white">
      {lang === 'id' ? 'SORAFY ADALAH ' : 'SORAFY IS A '}
      <span
        class="inline-block text-[#00E599]"
        style="text-shadow: 2px 2px 0px rgba(0, 229, 153, 0.25);"
      >
        {lang === 'id' ? 'PEMUTAR MUSIK' : 'MUSIC PLAYER'}
      </span>
      <br />
      <Typewriter client:load lang={lang} />
    </h1>
  </div>

  <!-- 2-Column Split Banner Layout (Desktop Mockup on Left + Downloads Box on Right) -->
  <div class="grid grid-cols-1 items-center gap-8 lg:gap-10 lg:grid-cols-[1.3fr_1fr] relative z-10 max-w-6xl mx-auto">
    <!-- Left Column: Desktop Player & Overlapping Phone Jam Remote -->
    <div class="flex justify-center pb-6 lg:pb-0">
      <HeroMockupStage lang={lang} />
    </div>

    <!-- Right Column: Interactive Downloads & Package Repository Box -->
    <div class="flex justify-center">
      <HeroDownloadsBox client:load lang={lang} />
    </div>
  </div>
</section>
