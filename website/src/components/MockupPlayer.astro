---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="w-full max-w-5xl mx-auto">
  <div class="bg-surface border border-medium rounded-2xl overflow-hidden shadow-2xl">
    <!-- Window Titlebar -->
    <div class="h-10 bg-surface-elevated border-b border-subtle flex items-center justify-between px-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
      </div>
      <div class="text-xs font-semibold text-neutral-400">
        SoraFy Desktop — High-Fidelity Music Streaming
      </div>
      <div class="flex items-center gap-1.5 text-[11px] font-mono-code text-[#00E599] bg-emerald-subtle border border-emerald-subtle px-2.5 py-0.5 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-[#00E599] animate-pulse"></span>
        Port 8800 Active
      </div>
    </div>

    <!-- 3-Column App Interface -->
    <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] lg:grid-cols-[190px_1fr_260px] min-h-[440px] bg-canvas">
      <!-- Left Mini Sidebar -->
      <div class="hidden md:flex flex-col justify-between bg-surface border-r border-subtle p-4">
        <div>
          <div class="flex items-center gap-2 mb-5">
            <img src="/assets/logo.png" alt="SoraFy" class="w-6 h-6 rounded object-contain" />
            <span class="font-bold text-sm text-white">sorafy</span>
          </div>

          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded bg-surface-subtle text-[#00E599] font-semibold text-xs">
              <span class="text-[10px]">►</span>
              <span>{t('mockup_nav_home')}</span>
            </div>
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded text-neutral-400 hover:text-white font-medium text-xs transition-colors">
              <span class="text-[10px]">◎</span>
              <span>{t('mockup_nav_explore')}</span>
            </div>
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded text-neutral-400 hover:text-white font-medium text-xs transition-colors">
              <span class="text-[10px]">⚙</span>
              <span>{t('mockup_nav_equalizer')}</span>
            </div>
            <div class="flex items-center gap-2.5 px-2.5 py-1.5 rounded text-neutral-400 hover:text-white font-medium text-xs transition-colors">
              <span class="text-[10px]">📊</span>
              <span>{t('mockup_nav_stats')}</span>
            </div>
          </div>
        </div>

        <div class="pt-3 border-t border-subtle">
          <span class="text-[10px] font-mono-code text-neutral-500">Opus 160kbps HD</span>
        </div>
      </div>

      <!-- Main Stage -->
      <div class="p-5 flex flex-col gap-4">
        <!-- Search Preview -->
        <div class="flex items-center gap-2.5 bg-surface border border-subtle px-3 py-1.5 rounded-lg text-xs text-neutral-500">
          <span>🔍</span>
          <span class="truncate">{t('mockup_search_placeholder')}</span>
        </div>

        <!-- Now Playing Track Banner -->
        <div class="flex items-center gap-4 bg-surface border border-subtle rounded-xl p-3.5">
          <div class="w-14 h-14 rounded-lg bg-gradient-to-br from-neutral-800 to-neutral-950 flex items-center justify-center border border-subtle shrink-0 text-[#00E599]">
            <span class="text-sm">►</span>
          </div>
          <div class="min-w-0 flex-1">
            <span class="text-[10px] font-bold text-[#00E599] tracking-wider block">
              {t('mockup_now_playing')}
            </span>
            <h4 class="text-sm font-bold text-white truncate">Satu Bulan</h4>
            <p class="text-xs text-neutral-400 truncate">Bernadya • Sialnya, Hidup Harus Tetap Berjalan</p>
            <div class="flex gap-1.5 mt-1.5 flex-wrap">
              <span class="text-[10px] font-semibold px-1.5 py-0.5 bg-surface-elevated border border-subtle rounded text-neutral-300">Lossless Match</span>
              <span class="text-[10px] font-semibold px-1.5 py-0.5 bg-surface-elevated border border-subtle rounded text-neutral-300">Synced Lyrics</span>
              <span class="text-[10px] font-semibold px-1.5 py-0.5 bg-surface-elevated border border-subtle rounded text-[#00E599]">EQ Parametric Active</span>
            </div>
          </div>
        </div>

        <!-- 7-Band Parametric EQ Active Curve -->
        <div class="bg-surface border border-subtle rounded-xl p-3.5">
          <div class="flex justify-between items-center text-xs mb-3">
            <span class="text-neutral-400 font-medium">{t('mockup_eq_title')}</span>
            <span class="text-[#00E599] font-semibold text-[11px]">Bass Boost + Vocal Air</span>
          </div>

          <div class="flex items-end justify-between h-16 px-2 border-b border-dashed border-subtle pb-1">
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 78%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">32Hz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 65%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">64Hz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 45%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">125Hz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 52%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">500Hz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 70%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">2kHz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 82%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">8kHz</span>
            </div>
            <div class="flex flex-col items-center gap-1 w-5 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 90%;"></div>
              <span class="text-[9px] font-mono-code text-neutral-500">16kHz</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Synced Lyrics Sidebar -->
      <div class="hidden lg:flex flex-col gap-3 bg-surface border-l border-subtle p-4">
        <div class="flex items-center justify-between border-b border-subtle pb-2">
          <span class="text-xs font-bold text-white">{t('mockup_lyrics_title')}</span>
          <span class="text-[10px] font-mono-code text-[#00E599]">LRCLIB Sync</span>
        </div>

        <div class="flex flex-col gap-2.5 text-xs">
          <p class="text-neutral-500">Belum ada satu bulan</p>
          <p class="text-neutral-500">Ku yakin masih ada yang tertinggal</p>
          <p class="text-[#00E599] font-bold text-sm flex items-center gap-1.5">
            <span>♫</span>
            <span>Dan belum ada satu bulan</span>
          </p>
          <p class="text-neutral-500">Ku dengar kamu sudah ada yang baru</p>
          <p class="text-neutral-500">Cepat juga kamu melupakan</p>
        </div>
      </div>
    </div>

    <!-- Bottom Transport Bar -->
    <div class="h-13 bg-surface-elevated border-t border-subtle flex items-center justify-between px-4">
      <div class="flex items-center gap-2.5 w-44">
        <div class="w-8 h-8 rounded bg-neutral-800"></div>
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-white truncate">Satu Bulan</span>
          <span class="text-[10px] text-neutral-400">Bernadya</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class="text-neutral-400 text-xs cursor-pointer">⏮</span>
        <span class="text-[#00E599] text-sm cursor-pointer">❚❚</span>
        <span class="text-neutral-400 text-xs cursor-pointer">⏭</span>
        <div class="hidden sm:flex items-center gap-2 w-48">
          <span class="text-[10px] font-mono-code text-neutral-400">1:42</span>
          <div class="flex-1 h-1 bg-surface-subtle rounded-full overflow-hidden">
            <div class="h-full bg-[#00E599]" style="width: 48%;"></div>
          </div>
          <span class="text-[10px] font-mono-code text-neutral-400">3:28</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono-code px-2 py-0.5 rounded bg-surface border border-subtle text-neutral-400">Jam Active</span>
        <span class="text-[10px] font-mono-code px-2 py-0.5 rounded bg-surface border border-subtle text-neutral-400">MPD: 6600</span>
      </div>
    </div>
  </div>
</div>
