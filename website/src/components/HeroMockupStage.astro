---
import { useTranslations } from '../i18n/ui';
import { 
  Home2, 
  Discover, 
  Folder2, 
  Setting2, 
  SearchNormal1, 
  Play, 
  Pause, 
  Previous, 
  Next 
} from 'iconsax-react';

interface Props {
  lang: 'en' | 'id';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="relative w-full max-w-2xl mx-auto group">
  <!-- Desktop Player Window Box -->
  <div class="bg-surface border border-neutral-800 hover:border-[#00E599]/40 rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.85)] transition-all duration-300">
    <!-- Window Titlebar -->
    <div class="h-9 bg-surface-elevated border-b border-subtle flex items-center justify-between px-3.5">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F] inline-block"></span>
      </div>
      <div class="text-[11px] font-semibold text-neutral-400 truncate max-w-[200px]">
        SoraFy Desktop — High-Fidelity
      </div>
      <div class="flex items-center gap-1 text-[10px] font-mono-code text-[#00E599] bg-[#00E599]/10 border border-[#00E599]/25 px-2 py-0.5 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-[#00E599] animate-pulse"></span>
        <span>Port 8800</span>
      </div>
    </div>

    <!-- App Body (Compact Grid) -->
    <div class="grid grid-cols-[140px_1fr] sm:grid-cols-[150px_1fr] min-h-[360px] bg-canvas">
      <!-- Mini Sidebar -->
      <div class="flex flex-col justify-between bg-surface border-r border-subtle p-3 text-xs">
        <div>
          <div class="flex items-center gap-1.5 mb-4">
            <img src={`${base}/assets/logo.png`} alt="SoraFy" class="w-5 h-5 rounded object-contain" />
            <span class="font-bold text-xs text-white">sorafy</span>
          </div>

          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-surface-subtle text-[#00E599] font-bold text-[11px]">
              <Home2 size={13} variant="Bold" className="shrink-0" />
              <span>{t('mockup_nav_home')}</span>
            </div>
            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md text-neutral-400 hover:text-white font-medium text-[11px] transition-colors">
              <Discover size={13} variant="Linear" className="shrink-0" />
              <span>{t('mockup_nav_explore')}</span>
            </div>
            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md text-neutral-400 hover:text-white font-medium text-[11px] transition-colors">
              <Folder2 size={13} variant="Linear" className="shrink-0" />
              <span>{t('mockup_nav_library')}</span>
            </div>
            <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-md text-neutral-400 hover:text-white font-medium text-[11px] transition-colors">
              <Setting2 size={13} variant="Linear" className="shrink-0" />
              <span>{t('mockup_nav_settings')}</span>
            </div>
          </div>
        </div>

        <div class="pt-2 border-t border-subtle">
          <span class="text-[9px] font-mono-code text-neutral-500">Opus 160kbps</span>
        </div>
      </div>

      <!-- Main Stage Content -->
      <div class="p-4 flex flex-col gap-3">
        <!-- Search Bar -->
        <div class="flex items-center gap-2 bg-surface border border-subtle px-2.5 py-1.5 rounded-lg text-[11px] text-neutral-500">
          <SearchNormal1 size={12} variant="Linear" className="text-neutral-500 shrink-0" />
          <span class="truncate">{t('mockup_search_placeholder')}</span>
        </div>

        <!-- Spotlight Track -->
        <div class="flex items-center gap-3 bg-surface-elevated/70 border border-subtle hover:border-[#00E599]/30 rounded-xl p-3 transition-colors">
          <div class="relative w-11 h-11 rounded-lg bg-gradient-to-br from-emerald-950 via-neutral-900 to-neutral-950 flex items-center justify-center border border-[#00E599]/30 shrink-0 overflow-hidden shadow-md">
            <div class="absolute inset-0 bg-gradient-to-tr from-[#00E599]/20 to-transparent"></div>
            <Play size={14} variant="Bold" className="text-[#00E599] drop-shadow-[0_0_8px_#00E599]" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 mb-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00E599] animate-pulse"></span>
              <span class="text-[9px] font-bold text-[#00E599] tracking-wider uppercase">
                {t('mockup_now_playing')}
              </span>
            </div>
            <h4 class="text-xs font-bold text-white truncate">Satu Bulan</h4>
            <p class="text-[10px] text-neutral-400 truncate">Bernadya • Sialnya, Hidup Harus Tetap Berjalan</p>
            <div class="flex gap-1.5 mt-1">
              <span class="text-[9px] font-semibold font-mono-code px-1.5 py-0.2 bg-canvas/80 border border-subtle rounded text-[#00E599]">Lossless</span>
              <span class="text-[9px] font-semibold font-mono-code px-1.5 py-0.2 bg-canvas/80 border border-subtle rounded text-neutral-300">Synced LRC</span>
              <span class="text-[9px] font-semibold font-mono-code px-1.5 py-0.2 bg-canvas/80 border border-subtle rounded text-neutral-400">DSP</span>
            </div>
          </div>
        </div>

        <!-- 7-Band Parametric EQ Curve Mini-Viz -->
        <div class="bg-surface border border-subtle rounded-xl p-3">
          <div class="flex justify-between items-center text-[11px] mb-2">
            <span class="text-neutral-400 font-medium">{t('mockup_eq_title')}</span>
            <span class="text-[#00E599] font-bold text-[10px]">Bass Boost + Air</span>
          </div>

          <div class="flex items-end justify-between h-12 px-1 border-b border-dashed border-subtle pb-1">
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 80%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">32</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 65%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">64</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 45%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">125</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 55%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">500</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 72%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">2k</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 85%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">8k</span>
            </div>
            <div class="flex flex-col items-center gap-0.5 w-4 h-full justify-end">
              <div class="w-full bg-[#00E599] rounded-t" style="height: 90%;"></div>
              <span class="text-[8px] font-mono-code text-neutral-500">16k</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Transport Bar -->
    <div class="h-11 bg-surface-elevated border-t border-subtle flex items-center justify-between px-3">
      <div class="flex items-center gap-2">
        <button type="button" class="text-neutral-400 hover:text-white transition-colors" aria-label="Previous">
          <Previous size={12} variant="Bold" />
        </button>
        <button type="button" class="text-[#00E599] hover:text-[#00B377] transition-colors" aria-label="Pause">
          <Pause size={14} variant="Bold" />
        </button>
        <button type="button" class="text-neutral-400 hover:text-white transition-colors" aria-label="Next">
          <Next size={12} variant="Bold" />
        </button>
        <span class="text-[10px] font-mono-code text-neutral-400 ml-1">1:42 / 3:28</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-[9px] font-mono-code px-1.5 py-0.5 rounded bg-surface border border-subtle text-neutral-400">Jam: 4120</span>
        <span class="text-[9px] font-mono-code px-1.5 py-0.5 rounded bg-surface border border-subtle text-neutral-400">MPD: 6600</span>
      </div>
    </div>
  </div>

  <!-- Floating Mobile Mockup: SoraFy Jam Phone Remote -->
  <div class="absolute -bottom-6 -right-2 sm:-right-4 z-20 w-[38%] max-w-[195px] shadow-[0_20px_45px_rgba(0,0,0,0.85)] hover:scale-105 transition-all duration-300">
    <div class="bg-[#0B0D10]/95 border border-medium hover:border-[#00E599]/60 rounded-2xl overflow-hidden p-2.5 shadow-2xl backdrop-blur-md">
      <!-- Notch & Header -->
      <div class="flex items-center justify-between border-b border-subtle pb-1.5 mb-2">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00E599] animate-pulse"></span>
          <span class="text-[9px] font-bold text-white uppercase tracking-wider">SORAFY JAM</span>
        </div>
        <span class="text-[8px] font-mono-code font-bold text-[#00E599] bg-[#00E599]/10 border border-[#00E599]/20 px-1.5 py-0.2 rounded">WiFi</span>
      </div>

      <!-- Phone Track Card -->
      <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-emerald-950/80 via-neutral-900 to-neutral-800 border border-subtle flex flex-col items-center justify-center mb-2 shadow-inner relative overflow-hidden">
        <div class="w-9 h-9 rounded-full bg-[#00E599]/20 flex items-center justify-center border border-[#00E599]/40 mb-1">
          <Play size={14} variant="Bold" className="text-[#00E599]" />
        </div>
        <span class="text-[8px] font-mono-code text-neutral-400">Remote Session</span>
      </div>

      <!-- Track Info -->
      <div class="text-center mb-2">
        <p class="text-[11px] font-bold text-white truncate">Satu Bulan</p>
        <p class="text-[9px] text-neutral-400 truncate">Bernadya</p>
      </div>

      <!-- Controls -->
      <div class="flex items-center justify-center gap-3.5 text-neutral-300 py-1.5 bg-surface-elevated/80 rounded-lg border border-subtle text-[11px]">
        <Previous size={11} variant="Bold" className="cursor-pointer hover:text-white transition-colors" />
        <Pause size={13} variant="Bold" className="text-[#00E599] cursor-pointer hover:text-[#00B377] transition-colors" />
        <Next size={11} variant="Bold" className="cursor-pointer hover:text-white transition-colors" />
      </div>
    </div>
  </div>
</div>
